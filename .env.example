# GreenFed-XAI Environment Variables Configuration Template
# Copy to .env for local overrides

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=False

# Frontend Web Dashboard Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
PORT=3000

# Blockchain Ledger Configuration
LEDGER_TYPE=MOCK_LEDGER
FABRIC_CHANNEL=greenfed-channel
FABRIC_CHAINCODE=greenfed-chaincode

# FL Security Thresholds
NORM_THRESHOLD_TAU=2.50
QUORUM_PERCENTAGE=50.0

